# En-têtes HTTP lus par Cloudflare (ignorés par GitHub Pages).
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://data.geopf.fr; font-src 'self'; connect-src 'self' https://kaenkiakgrkucdxticze.supabase.co wss://kaenkiakgrkucdxticze.supabase.co https://api.open-meteo.com https://archive-api.open-meteo.com https://geocoding-api.open-meteo.com https://nominatim.openstreetmap.org; frame-src https://www.rimpro.eu; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Toujours vérifier la dernière version de la page et du service worker
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/service-worker.js
  Cache-Control: no-cache

# Bibliothèques (numéro de version dans le nom du fichier) et polices : gardées un an
/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Logos et icônes : 30 jours
/assets/img/*
  Cache-Control: public, max-age=2592000
